# Dockerfile.clang
FROM ubuntu:24.04

# Install the stable LLVM 23.1.1 release and its supporting tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    cppcheck \
    curl \
    doxygen \
    git \
    graphviz \
    jq \
    ninja-build \
    wget xz-utils \
 && rm -rf /var/lib/apt/lists/*

COPY tools/install-llvm.sh /tmp/install-llvm.sh
RUN bash /tmp/install-llvm.sh && rm /tmp/install-llvm.sh
ENV PATH="/opt/llvm-23.1.1/bin:${PATH}"

# Create working directory
WORKDIR /project

# Default command
CMD ["/bin/bash"]
